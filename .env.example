# BiliLearn-AI 环境变量示例（可选）
# 模型密钥也可以直接在网页「配置」页填写，同样只保存在本地 SQLite，不会上传。
BILI_DEFAULT_PROVIDER=deepseek
BILI_DEEPSEEK_API_KEY=
BILI_KIMI_API_KEY=
BILI_QWEN_API_KEY=
BILI_OPENAI_API_KEY=
BILI_OLLAMA_BASE_URL=http://localhost:11434
# 笔记数据库 / Markdown / 关键帧截图的存放目录（默认 ~/BiliLearn-AI）
# BILI_DATA_DIR=D:\BiliLearn-AI-data
# 语音识别模型（faster-whisper）下载源。国内直连 huggingface.co 常超时，
# start.ps1 / start.sh / 图形启动器已默认设为国内镜像；这里可以覆盖。
# 也可在网页「设置 → 模型下载源」里改（该项优先于环境变量）。
# HF_ENDPOINT=https://hf-mirror.com
